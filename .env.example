# Application settings
PS_TOOL_WEB_HOST=127.0.0.1
PS_TOOL_WEB_PORT=8000
PS_TOOL_WEB_RELOAD=true

# Paths (relative to repo root)
PS_TOOL_CONFIG_DIR=config
PS_TOOL_DATA_DIR=data

# Snapshot cache TTL in seconds
SNAPSHOT_CACHE_TTL_SEC=180

# SQLite search index
SEARCH_DB_PATH=data/search.db

# Mock adapters always used in Phase 2; set false when real connectors are wired
USE_MOCK_ADAPTERS=true

# Canonical mock dataset used until real scheduler adapters are wired.
# reference_2500 = environment-neutral 2,500-job fixture; legacy_small = compact demo.
MOCK_DATASET=reference_2500
MOCK_REFERENCE_PATH=data/mock/reference_topology_2500.jsonl
MOCK_SCENARIO=u1_to_u5_migration
MOCK_SCENARIO_PATH=data/mock/u1_to_u5_migration_overlay.jsonl

# Optional generated flat topology size for ad-hoc UX/load testing; >0 overrides MOCK_DATASET.
MOCK_JOB_COUNT=0

# Table page size default: 0 = show all rows on first load
TABLE_PAGE_SIZE=0

# Allow Settings UI to persist scheduler host/connection edits.
# Disable in deployments where connection targets must be deployment-managed only.
ALLOW_CONNECTION_CONFIG_EDIT=true

# Single durable current comparison snapshot (no history/revisions)
CURRENT_SNAPSHOT_DIR=data/runtime/current
